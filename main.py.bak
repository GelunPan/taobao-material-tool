import sys
import os
import json
from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QTableWidget, QTableWidgetItem, QPushButton, QLineEdit, QLabel,
    QHeaderView, QAbstractItemView, QMessageBox, QTreeWidget, QTreeWidgetItem,
    QSplitter, QFileDialog, QInputDialog, QDialog, QFormLayout,
    QTextEdit, QDialogButtonBox
)
from PyQt6.QtCore import Qt
from PyQt6.QtGui import QPixmap, QImage, QIcon


class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("淘宝评价素材整理工具")
        self.setGeometry(100, 100, 1400, 700)

        # 数据存储目录
        self.data_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data")
        self.images_dir = os.path.join(self.data_dir, "images")
        os.makedirs(self.images_dir, exist_ok=True)
        self.data_file = os.path.join(self.data_dir, "data.json")

        # 初始化数据结构
        self.shops = {}  # {店铺名: [素材记录列表]}
        self.current_shop = None
        self.image_counter = 0  # 用于生成图片文件名

        self.init_ui()
        self.load_data()

    def init_ui(self):
        """初始化界面"""
        central_widget = QWidget()
        self.setCentralWidget(central_widget)
        main_layout = QHBoxLayout(central_widget)

        # 左右分割器
        splitter = QSplitter(Qt.Orientation.Horizontal)
        main_layout.addWidget(splitter)

        # ========== 左侧：店铺面板 ==========
        left_widget = QWidget()
        left_layout = QVBoxLayout(left_widget)
        left_layout.setContentsMargins(5, 5, 5, 5)

        left_label = QLabel("店铺列表")
        left_label.setStyleSheet("font-weight: bold; font-size: 14px;")
        left_layout.addWidget(left_label)

        self.shop_tree = QTreeWidget()
        self.shop_tree.setHeaderLabels(["店铺名称"])
        self.shop_tree.setAlternatingRowColors(True)
        self.shop_tree.itemClicked.connect(self.on_shop_selected)
        self.shop_tree.itemDoubleClicked.connect(self.on_shop_double_clicked)
        left_layout.addWidget(self.shop_tree)

        shop_btn_layout = QHBoxLayout()
        self.btn_add_shop = QPushButton("+ 新店铺")
        self.btn_rename_shop = QPushButton("重命名")
        self.btn_delete_shop = QPushButton("删除店铺")
        shop_btn_layout.addWidget(self.btn_add_shop)
        shop_btn_layout.addWidget(self.btn_rename_shop)
        shop_btn_layout.addWidget(self.btn_delete_shop)
        left_layout.addLayout(shop_btn_layout)

        self.btn_add_shop.clicked.connect(self.on_add_shop)
        self.btn_rename_shop.clicked.connect(self.on_rename_shop)
        self.btn_delete_shop.clicked.connect(self.on_delete_shop)

        splitter.addWidget(left_widget)

        # ========== 右侧：素材表格面板 ==========
        right_widget = QWidget()
        right_layout = QVBoxLayout(right_widget)
        right_layout.setContentsMargins(5, 5, 5, 5)

        self.current_shop_label = QLabel("请选择左侧店铺")
        self.current_shop_label.setStyleSheet("font-weight: bold; font-size: 14px; color: #333;")
        right_layout.addWidget(self.current_shop_label)

        # 表格 - 8列
        self.table = QTableWidget()
        self.table.setColumnCount(8)
        self.table.setHorizontalHeaderLabels([
            "商品ID", "规格图", "规格", "标题", "链接主图", "补手", "买家秀评价", "图片"
        ])
        self.table.setAlternatingRowColors(True)
        self.table.setSelectionBehavior(QAbstractItemView.SelectionBehavior.SelectRows)
        self.table.setEditTriggers(QAbstractItemView.EditTrigger.DoubleClicked |
                                   QAbstractItemView.EditTrigger.SelectedClicked)
        header = self.table.horizontalHeader()
        # 设置各列宽度模式
        header.setSectionResizeMode(0, QHeaderView.ResizeMode.ResizeToContents)  # 商品ID
        header.setSectionResizeMode(1, QHeaderView.ResizeMode.ResizeToContents)  # 规格图
        header.setSectionResizeMode(2, QHeaderView.ResizeMode.ResizeToContents)  # 规格
        header.setSectionResizeMode(3, QHeaderView.ResizeMode.Stretch)           # 标题
        header.setSectionResizeMode(4, QHeaderView.ResizeMode.ResizeToContents)  # 链接主图
        header.setSectionResizeMode(5, QHeaderView.ResizeMode.ResizeToContents)  # 补手
        header.setSectionResizeMode(6, QHeaderView.ResizeMode.Stretch)           # 买家秀评价
        header.setSectionResizeMode(7, QHeaderView.ResizeMode.ResizeToContents)  # 图片

        right_layout.addWidget(self.table)

        tip_label = QLabel("提示：在图片单元格中按 Ctrl+V 可直接粘贴截图/图片")
        tip_label.setStyleSheet("color: #888; font-size: 12px;")
        right_layout.addWidget(tip_label)

        # 底部操作栏
        bottom_layout = QHBoxLayout()
        self.btn_add = QPushButton("新增记录")
        self.btn_delete = QPushButton("删除选中行")
        self.btn_export = QPushButton("导出Excel")
        self.search_input = QLineEdit()
        self.search_input.setPlaceholderText("按标题搜索...")
        self.btn_search = QPushButton("搜索")
        self.btn_clear_search = QPushButton("清除搜索")

        bottom_layout.addWidget(self.btn_add)
        bottom_layout.addWidget(self.btn_delete)
        bottom_layout.addStretch()
        bottom_layout.addWidget(QLabel("搜索:"))
        bottom_layout.addWidget(self.search_input)
        bottom_layout.addWidget(self.btn_search)
        bottom_layout.addWidget(self.btn_clear_search)
        bottom_layout.addWidget(self.btn_export)

        right_layout.addLayout(bottom_layout)

        splitter.addWidget(right_widget)
        splitter.setSizes([250, 1150])

        # 绑定事件
        self.btn_add.clicked.connect(self.on_add_record)
        self.btn_delete.clicked.connect(self.on_delete_record)
        self.btn_export.clicked.connect(self.on_export)
        self.btn_search.clicked.connect(self.on_search)
        self.btn_clear_search.clicked.connect(self.on_clear_search)
        self.search_input.returnPressed.connect(self.on_search)

    # ==================== 店铺管理 ====================
    def on_add_shop(self):
        name, ok = QInputDialog.getText(self, "添加店铺", "请输入店铺名称:")
        if ok and name.strip():
            name = name.strip()
            if name in self.shops:
                QMessageBox.warning(self, "提示", "该店铺已存在！")
                return
            self.shops[name] = []
            self.refresh_shop_tree()
            self.save_data()
            self.select_shop_in_tree(name)

    def on_rename_shop(self):
        item = self.shop_tree.currentItem()
        if not item:
            QMessageBox.information(self, "提示", "请先选择要重命名的店铺")
            return
        old_name = item.text(0)
        new_name, ok = QInputDialog.getText(self, "重命名店铺", "请输入新名称:", text=old_name)
        if ok and new_name.strip() and new_name.strip() != old_name:
            new_name = new_name.strip()
            if new_name in self.shops:
                QMessageBox.warning(self, "提示", "该店铺名已存在！")
                return
            self.shops[new_name] = self.shops.pop(old_name)
            if self.current_shop == old_name:
                self.current_shop = new_name
                self.current_shop_label.setText(f"当前店铺：{new_name}")
            self.refresh_shop_tree()
            self.save_data()

    def on_delete_shop(self):
        item = self.shop_tree.currentItem()
        if not item:
            QMessageBox.information(self, "提示", "请先选择要删除的店铺")
            return
        name = item.text(0)
        reply = QMessageBox.question(self, "确认删除", f"确定要删除店铺 '{name}' 及其所有素材吗？",
                                     QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if reply == QMessageBox.StandardButton.Yes:
            del self.shops[name]
            if self.current_shop == name:
                self.current_shop = None
                self.current_shop_label.setText("请选择左侧店铺")
                self.table.setRowCount(0)
            self.refresh_shop_tree()
            self.save_data()

    def on_shop_selected(self, item, column):
        if item.parent() is None:
            self.current_shop = item.text(0)
        else:
            self.current_shop = item.parent().text(0)
        self.current_shop_label.setText(f"当前店铺：{self.current_shop}")
        self.load_shop_records(self.current_shop)

    def on_shop_double_clicked(self, item, column):
        if item.childCount() > 0:
            item.setExpanded(not item.isExpanded())

    def refresh_shop_tree(self):
        self.shop_tree.clear()
        for shop_name, records in self.shops.items():
            shop_item = QTreeWidgetItem([shop_name])
            shop_item.setFlags(shop_item.flags() | Qt.ItemFlag.ItemIsEditable)
            self.shop_tree.addTopLevelItem(shop_item)
            count_item = QTreeWidgetItem([f"素材数量：{len(records)}"])
            count_item.setFlags(count_item.flags() & ~Qt.ItemFlag.ItemIsEditable)
            shop_item.addChild(count_item)
        self.shop_tree.expandAll()

    def select_shop_in_tree(self, name):
        for i in range(self.shop_tree.topLevelItemCount()):
            item = self.shop_tree.topLevelItem(i)
            if item.text(0) == name:
                self.shop_tree.setCurrentItem(item)
                self.on_shop_selected(item, 0)
                break

    # ==================== 素材记录管理 ====================
    def on_add_record(self):
        if not self.current_shop:
            QMessageBox.information(self, "提示", "请先在左侧选择或创建一个店铺")
            return

        dialog = AddRecordDialog(self)
        if dialog.exec() == QDialog.DialogCode.Accepted:
            record = dialog.get_data()
            if record:
                if self.current_shop not in self.shops:
                    self.shops[self.current_shop] = []
                self.shops[self.current_shop].append(record)
                self.load_shop_records(self.current_shop)
                self.refresh_shop_tree()
                self.save_data()

    def on_delete_record(self):
        if not self.current_shop:
            QMessageBox.information(self, "提示", "请先选择店铺")
            return
        current_row = self.table.currentRow()
        if current_row < 0:
            QMessageBox.information(self, "提示", "请先选中要删除的行")
            return
        reply = QMessageBox.question(self, "确认删除", "确定要删除选中的记录吗？",
                                     QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if reply == QMessageBox.StandardButton.Yes:
            self.shops[self.current_shop].pop(current_row)
            self.load_shop_records(self.current_shop)
            self.refresh_shop_tree()
            self.save_data()

    def load_shop_records(self, shop_name):
        """加载指定店铺的素材记录到表格"""
        self.table.setRowCount(0)
        if shop_name not in self.shops:
            return
        records = self.shops[shop_name]
        self.table.setRowCount(len(records))
        
        for row, record in enumerate(records):
            # 商品ID
            self.table.setItem(row, 0, QTableWidgetItem(record.get("product_id", "")))
            # 规格图
            self.set_image_cell(row, 1, record.get("spec_image", ""), "spec_image")
            # 规格
            self.table.setItem(row, 2, QTableWidgetItem(record.get("spec", "")))
            # 标题
            self.table.setItem(row, 3, QTableWidgetItem(record.get("title", "")))
            # 链接主图
            self.set_image_cell(row, 4, record.get("link_image", ""), "link_image")
            # 补手
            self.table.setItem(row, 5, QTableWidgetItem(record.get("helper", "")))
            # 买家秀评价
            self.table.setItem(row, 6, QTableWidgetItem(record.get("review", "")))
            # 图片
            self.set_image_cell(row, 7, record.get("image_path", ""), "image_path")
            
            self.table.setRowHeight(row, 110)

    def set_image_cell(self, row, col, image_path, field_name):
        """设置图片单元格"""
        if image_path and os.path.exists(image_path):
            pixmap = QPixmap(image_path)
            if not pixmap.isNull():
                scaled_pixmap = pixmap.scaled(100, 100, Qt.AspectRatioMode.KeepAspectRatio,
                                              Qt.TransformationMode.SmoothTransformation)
                img_label = QLabel()
                img_label.setPixmap(scaled_pixmap)
                img_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
                img_label.setToolTip("双击查看大图\n按Ctrl+V粘贴新图片")
                img_label.mouseDoubleClickEvent = lambda event, p=image_path: self.show_full_image(p)
                self.table.setCellWidget(row, col, img_label)
                self.table.setItem(row, col, QTableWidgetItem(image_path))
            else:
                self.table.setItem(row, col, QTableWidgetItem("图片无效"))
        else:
            placeholder = QLabel("（粘贴图片）")
            placeholder.setAlignment(Qt.AlignmentFlag.AlignCenter)
            placeholder.setStyleSheet("color: #aaa; border: 1px dashed #ccc; padding: 10px;")
            placeholder.mouseDoubleClickEvent = lambda event, r=row, c=col, f=field_name: self.paste_image_to_cell(r, c, f)
            self.table.setCellWidget(row, col, placeholder)
            self.table.setItem(row, col, QTableWidgetItem(""))

    def show_full_image(self, image_path):
        """查看大图"""
        if not os.path.exists(image_path):
            QMessageBox.information(self, "提示", "图片文件不存在")
            return
        dialog = QDialog(self)
        dialog.setWindowTitle("查看图片")
        dialog.setMinimumSize(500, 500)
        layout = QVBoxLayout(dialog)
        label = QLabel()
        pixmap = QPixmap(image_path)
        if pixmap.width() > 800 or pixmap.height() > 800:
            pixmap = pixmap.scaled(800, 800, Qt.AspectRatioMode.KeepAspectRatio,
                                   Qt.TransformationMode.SmoothTransformation)
        label.setPixmap(pixmap)
        label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(label)
        dialog.exec()

    def paste_image_to_cell(self, row, col, field_name):
        """在指定单元格粘贴图片"""
        clipboard = QApplication.clipboard()
        mime = clipboard.mimeData()
        if mime.hasImage():
            image = QImage(clipboard.image())
            if not image.isNull():
                self.image_counter += 1
                filename = f"image_{self.image_counter:04d}.png"
                filepath = os.path.join(self.images_dir, filename)
                image.save(filepath, "PNG")
                if self.current_shop in self.shops and row < len(self.shops[self.current_shop]):
                    self.shops[self.current_shop][row][field_name] = filepath
                    self.load_shop_records(self.current_shop)
                    self.save_data()
                    QMessageBox.information(self, "成功", "图片已粘贴！")
                return
        QMessageBox.information(self, "提示", "剪贴板中没有图片，请先截图或复制图片后按Ctrl+V")

    # ==================== 搜索功能 ====================
    def on_search(self):
        keyword = self.search_input.text().strip().lower()
        if not keyword or not self.current_shop:
            if self.current_shop:
                self.load_shop_records(self.current_shop)
            return
        records = self.shops.get(self.current_shop, [])
        self.table.setRowCount(0)
        matched_indices = []
        for i, record in enumerate(records):
            title = record.get("title", "").lower()
            if keyword in title:
                matched_indices.append(i)
        self.table.setRowCount(len(matched_indices))
        for new_row, old_index in enumerate(matched_indices):
            record = records[old_index]
            self.table.setItem(new_row, 0, QTableWidgetItem(record.get("product_id", "")))
            self.set_image_cell(new_row, 1, record.get("spec_image", ""), "spec_image")
            self.table.setItem(new_row, 2, QTableWidgetItem(record.get("spec", "")))
            self.table.setItem(new_row, 3, QTableWidgetItem(record.get("title", "")))
            self.set_image_cell(new_row, 4, record.get("link_image", ""), "link_image")
            self.table.setItem(new_row, 5, QTableWidgetItem(record.get("helper", "")))
            self.table.setItem(new_row, 6, QTableWidgetItem(record.get("review", "")))
            self.set_image_cell(new_row, 7, record.get("image_path", ""), "image_path")
            self.table.setRowHeight(new_row, 110)

    def on_clear_search(self):
        self.search_input.clear()
        if self.current_shop:
            self.load_shop_records(self.current_shop)

    # ==================== 导出功能 ====================
    def on_export(self):
        if not self.current_shop:
            QMessageBox.information(self, "提示", "请先选择店铺")
            return
        try:
            from openpyxl import Workbook
            from openpyxl.styles import Font

            wb = Workbook()
            ws = wb.active
            ws.title = self.current_shop

            headers = ["商品ID", "规格图", "规格", "标题", "链接主图", "补手", "买家秀评价", "图片"]
            for col, header in enumerate(headers, 1):
                cell = ws.cell(row=1, column=col, value=header)
                cell.font = Font(bold=True)

            records = self.shops.get(self.current_shop, [])
            for row, record in enumerate(records, 2):
                ws.cell(row=row, column=1, value=record.get("product_id", ""))
                ws.cell(row=row, column=2, value=record.get("spec_image", ""))
                ws.cell(row=row, column=3, value=record.get("spec", ""))
                ws.cell(row=row, column=4, value=record.get("title", ""))
                ws.cell(row=row, column=5, value=record.get("link_image", ""))
                ws.cell(row=row, column=6, value=record.get("helper", ""))
                ws.cell(row=row, column=7, value=record.get("review", ""))
                ws.cell(row=row, column=8, value=record.get("image_path", ""))

            ws.column_dimensions['A'].width = 15
            ws.column_dimensions['B'].width = 30
            ws.column_dimensions['C'].width = 20
            ws.column_dimensions['D'].width = 40
            ws.column_dimensions['E'].width = 30
            ws.column_dimensions['F'].width = 15
            ws.column_dimensions['G'].width = 50
            ws.column_dimensions['H'].width = 30

            file_path, _ = QFileDialog.getSaveFileName(self, "导出Excel", 
                                                        f"{self.current_shop}_素材导出.xlsx",
                                                        "Excel文件 (*.xlsx)")
            if file_path:
                wb.save(file_path)
                QMessageBox.information(self, "成功", f"导出成功！\n文件保存在：{file_path}")
        except ImportError:
            QMessageBox.warning(self, "错误", "openpyxl库未安装，请运行: pip install openpyxl")
        except Exception as e:
            QMessageBox.warning(self, "错误", f"导出失败：{str(e)}")

    # ==================== 数据持久化 ====================
    def load_data(self):
        if os.path.exists(self.data_file):
            try:
                with open(self.data_file, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    self.shops = data.get("shops", {})
                    self.image_counter = data.get("image_counter", 0)
            except Exception as e:
                QMessageBox.warning(self, "警告", f"数据加载失败：{str(e)}\n将使用空数据。")
                self.shops = {}
        self.refresh_shop_tree()

    def save_data(self):
        try:
            data = {
                "shops": self.shops,
                "image_counter": self.image_counter
            }
            with open(self.data_file, 'w', encoding='utf-8') as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
        except Exception as e:
            QMessageBox.warning(self, "警告", f"数据保存失败：{str(e)}")


class AddRecordDialog(QDialog):
    """新增素材记录弹窗"""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("新增素材记录")
        self.setMinimumWidth(600)
        layout = QVBoxLayout(self)

        form_layout = QFormLayout()
        self.product_id_input = QLineEdit()
        self.spec_input = QLineEdit()
        self.title_input = QLineEdit()
        self.helper_input = QLineEdit()
        self.review_input = QTextEdit()
        self.review_input.setMaximumHeight(100)

        form_layout.addRow("商品ID:", self.product_id_input)
        form_layout.addRow("规格:", self.spec_input)
        form_layout.addRow("标题:", self.title_input)
        form_layout.addRow("补手:", self.helper_input)
        form_layout.addRow("买家秀评价:", self.review_input)
        layout.addLayout(form_layout)

        # 图片选择区域
        img_layout = QFormLayout()
        
        # 规格图
        spec_img_layout = QHBoxLayout()
        self.spec_img_label = QLabel("未选择图片")
        self.spec_img_label.setStyleSheet("color: #888;")
        btn_spec_img = QPushButton("选择")
        btn_spec_img.clicked.connect(lambda: self.select_image("spec"))
        spec_img_layout.addWidget(self.spec_img_label)
        spec_img_layout.addWidget(btn_spec_img)
        img_layout.addRow("规格图:", spec_img_layout)
        
        # 链接主图
        link_img_layout = QHBoxLayout()
        self.link_img_label = QLabel("未选择图片")
        self.link_img_label.setStyleSheet("color: #888;")
        btn_link_img = QPushButton("选择")
        btn_link_img.clicked.connect(lambda: self.select_image("link"))
        link_img_layout.addWidget(self.link_img_label)
        link_img_layout.addWidget(btn_link_img)
        img_layout.addRow("链接主图:", link_img_layout)
        
        # 评价图片
        review_img_layout = QHBoxLayout()
        self.review_img_label = QLabel("未选择图片")
        self.review_img_label.setStyleSheet("color: #888;")
        btn_review_img = QPushButton("选择")
        btn_review_img.clicked.connect(lambda: self.select_image("review"))
        review_img_layout.addWidget(self.review_img_label)
        review_img_layout.addWidget(btn_review_img)
        img_layout.addRow("评价图片:", review_img_layout)

        layout.addLayout(img_layout)

        # 按钮
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | 
                                   QDialogButtonBox.StandardButton.Cancel)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

        self.selected_images = {"spec": None, "link": None, "review": None}

    def select_image(self, img_type):
        """选择图片文件"""
        file_path, _ = QFileDialog.getOpenFileName(self, "选择图片", "",
                                                    "图片文件 (*.png *.jpg *.jpeg *.bmp *.gif)")
        if file_path:
            self.selected_images[img_type] = file_path
            if img_type == "spec":
                self.spec_img_label.setText(os.path.basename(file_path))
            elif img_type == "link":
                self.link_img_label.setText(os.path.basename(file_path))
            elif img_type == "review":
                self.review_img_label.setText(os.path.basename(file_path))

    def get_data(self):
        """获取输入的数据"""
        return {
            "product_id": self.product_id_input.text().strip(),
            "spec_image": self.selected_images.get("spec", ""),
            "spec": self.spec_input.text().strip(),
            "title": self.title_input.text().strip(),
            "link_image": self.selected_images.get("link", ""),
            "helper": self.helper_input.text().strip(),
            "review": self.review_input.toPlainText().strip(),
            "image_path": self.selected_images.get("review", "")
        }


if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = MainWindow()
    window.show()
    sys.exit(app.exec())